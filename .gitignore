# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# State / cache produced at runtime
.jobspine/
*.sqlite
*.sqlite3
bench/*.jsonl

# Large/intermediate extraction artifacts (gold lives in tests/data/, kept).
# Ignore /data/ contents but keep the curated registry CSVs (data/companies/),
# which are version-controlled and verified by the registry-verify CI workflow.
/data/*
!/data/companies/

# Env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Advisory runtime lockfiles (e.g. seed.json.lock). uv.lock is committed on purpose.
*.lock
!uv.lock

scripts/.h1b_cache/

# wikidata harvester scratch
scripts/.sector_wd_*.json

# Stage-2 PDL probe download cache (regenerated per run)
scripts/.probe_cache/

# scripts/ holds ONLY what CI runs or tests import. Everything else — one-off discovery,
# census, capture and audit tooling — lives in scripts/local/ and is never tracked. That split
# is enforced in CI; see the "scripts/local stays untracked" step in ci.yml.
scripts/local/
scripts/gov_names.txt
scripts/candidates_*.json
scripts/missing_public_companies.txt

# ATS-exhaustion ladder intermediate artifacts (regenerated by ats_exhaustion_sweep.py; the
# per-company logs in runs/exhaustion/ are the source of truth, cand_exhaustion.json is a proposed
# candidate batch rebuilt from them each run). NOTE: browser_queue.json is NOT ignored — it is the
# committed A->B contract that the Stream-B browser-discovery subsystem consumes.
runs/exhaustion/
scripts/cand_exhaustion.json
scripts/ladder_input.txt

# Playwright MCP throwaway session logs
.playwright-mcp/

# Tier-2 session-token store (SECRETS — never commit)
runs/tier2_tokens.json
*tier2_tokens.json
scripts/ladder_input_al.txt

# Docs are not tracked. Only the quickstart README links to is kept.
# NOTE the pattern: `docs/` (trailing slash) excludes the DIRECTORY, and git cannot re-include a
# file whose parent directory is excluded — the negation below would silently do nothing and
# mcp-quickstart.md would vanish too. `docs/*` excludes the CONTENTS, which keeps the negation live.
docs/*
!docs/mcp-quickstart.md
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/

# Agent/session scratch that has leaked into repos before.
.superpowers/
.claude/
scratchpad/
